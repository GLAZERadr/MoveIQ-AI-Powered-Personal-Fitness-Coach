{
  "expo": {
    "name": "MoveIQ",
    "slug": "adrian",
    "scheme": "moveiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moveiq.app",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.moveiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#071822",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "react-native-pose-detection",
        {
          "model": "full",
          "cameraPermissionText": "MoveIQ uses the camera to track your body position and count reps. Video is processed on this device and is never recorded or uploaded."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1DB954"
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#071822"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://moveiq-api.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.moveiq.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.moveiq.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "a8fd4d8b-e15f-40a2-be27-32f91dad0f1b"
      }
    },
    "owner": "glazeradrs-team"
  }
}
