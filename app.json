{
  "expo": {
    "name": "MoveIQ",
    "slug": "adrian",
    "scheme": "moveiq",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moveiq.app",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.moveiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#071822",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "react-native-pose-detection",
        {
          "model": "full",
          "cameraPermissionText": "MoveIQ uses the camera to track your body position and count reps. Video is processed on this device and is never recorded or uploaded."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1DB954"
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#071822"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MoveIQ uses your location only while you record a run, to measure distance, pace and your route. The route stays on your phone.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "MoveIQ saves your activity cards to your photos when you tap Save.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://moveiq-api.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.moveiq.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.moveiq.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "a8fd4d8b-e15f-40a2-be27-32f91dad0f1b"
      }
    },
    "owner": "glazeradrs-team"
  }
}
