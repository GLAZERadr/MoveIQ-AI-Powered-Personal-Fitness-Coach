{
  "name": "moveiq",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@better-auth/expo": "^1.7.11",
    "@expo/ui": "~58.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@hono/node-server": "^2.1.5",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "better-auth": "^1.7.11",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-media-library": "~58.0.11",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.21",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-pose-detection": "^0.2.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "jest",
    "lint": "expo lint",
    "build": "npm run typecheck && npm run build:server && npm run build:app",
    "build:server": "tsc -p server/tsconfig.json",
    "build:app": "expo export --platform ios --platform android --output-dir dist-app",
    "server:dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local --import tsx --watch server/local.ts",
    "server:start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local server/dist/local.js",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local --import tsx server/migrate.ts",
    "smoke:server": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.auth.local --import tsx server/smoke.ts",
    "deploy:api": "cd server && vercel deploy --prod",
    "auth:push": "node scripts/push-auth-env.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/server/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg)"
    ]
  }
}
